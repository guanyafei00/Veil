<?xml version="1.0" encoding="utf-8"?>
<!-- Lighter liquid-glass panel for the Settings (module cards) menu: same material and hue as
     glass_panel, but more translucent so it reads as a secondary / background surface next to the
     deeper tile long-press menu. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="#1C23262E"
                android:endColor="#1016181E" />
            <stroke android:width="1dp" android:color="#1EFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- top specular sheen: rounded to the panel's corners, or it would poke out of them -->
    <item android:bottom="72dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="#0DFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="22dp" android:topRightRadius="22dp" />
        </shape>
    </item>
</layer-list>

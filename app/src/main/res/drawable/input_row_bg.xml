<?xml version="1.0" encoding="utf-8"?>
<!-- Input / card / menu row: translucent charcoal glass at rest, matching the early long-press
     menu material; lower opacity keeps wallpaper visible and avoids opaque black pills. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270"
                        android:startColor="#E6FFFFFF"
                        android:endColor="#C8FFFFFF" />
                    <stroke android:width="1dp" android:color="#66FFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:bottom="14dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270"
                        android:startColor="#30FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <!-- Rounded to the row's corners: a square sheen pokes past the arc. -->
                    <corners android:topLeftRadius="16dp" android:topRightRadius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#661D2026" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>

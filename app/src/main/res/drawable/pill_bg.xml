<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid-glass pill, tvOS / Apple style.

     The material is genuinely translucent: you see the aerial wallpaper through it, tinted by a
     thin smoked layer, with a specular highlight on the top half and a darker refractive rim on
     the bottom edge. Text legibility is carried by the white label's own soft shadow (see
     PillTextView), NOT by painting the pill black — an opaque charcoal pill reads as a sticker
     on a bright sky frame and kills the whole glass effect, especially on the icon-free desktop.

     Layer-list items with an inset used to lose their corners on some TV ROMs (TCL mt5879) and
     paint a square plate behind the pill. Two independent safeguards now: every layer declares
     its own 21dp corners, and PillTextView clips the whole view to a capsule outline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <!-- Slightly translucent white: still unmistakably the focus, still glass. -->
                    <solid android:color="#F2FFFFFF" />
                    <!-- Faint dark rim separates the white pill from snow / bright cloud frames. -->
                    <stroke android:width="1dp" android:color="#4D000000" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
            <item android:bottom="21dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270"
                        android:startColor="#26FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- Smoked glass body: 35% -> 24% alpha, neutral charcoal. Bright frames show through
                 as tinted colour rather than being blocked, dark frames keep white text punchy. -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270"
                        android:startColor="#59272B33"
                        android:endColor="#3D171A21" />
                    <stroke android:width="1dp" android:color="#8CFFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
            <!-- Top specular sheen: the light-catching upper half of the glass. -->
            <item android:bottom="21dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270"
                        android:startColor="#38FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
            <!-- Bottom refractive rim: gives the glass a visible thickness. -->
            <item android:top="36dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270"
                        android:startColor="#00000000"
                        android:endColor="#33000000" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

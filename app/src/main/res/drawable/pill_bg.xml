<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted pill, tvOS / Apple-glass style: light translucent material + top sheen + bright rim. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270"
                        android:startColor="#33FFFFFF"
                        android:endColor="#15FFFFFF" />
                    <stroke android:width="1dp" android:color="#45FFFFFF" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item android:bottom="20dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270"
                        android:startColor="#22FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <!-- The sheen MUST carry the pill's corners: without them the square
                         layer peeked past the rounded arc at the top (the owner's photos). -->
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

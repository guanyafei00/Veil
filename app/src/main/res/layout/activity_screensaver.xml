<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/saverRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- The shared aerial video (the very same stream the desktop wallpaper plays), used only
         when the desktop wallpaper source is the aerial video. -->
    <SurfaceView
        android:id="@+id/saverVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- The static still the desktop uses when its wallpaper source is NOT the aerial video.
         Shown as-is (with a gentle breathe) so the screensaver matches the desktop.
         MUST sit ABOVE the SurfaceView: the surface paints an opaque black hole over every
         view below it, so a still placed underneath stayed invisible — the screensaver went
         black for the whole re-buffer window even though the still was "shown". -->
    <ImageView
        android:id="@+id/saverStill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Black curtain over the still/video: starts opaque and fades away once the content is
         actually on screen, so entering the screensaver (or a video -> still fallback) eases in
         instead of snapping. Sits above both content layers, below the clock. -->
    <View
        android:id="@+id/saverFade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000" />

    <LinearLayout
        android:id="@+id/saverClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="44dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/saverTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="60sp"
            android:shadowColor="#99000000"
            android:shadowRadius="12"
            android:shadowDx="0"
            android:shadowDy="2" />

        <TextView
            android:id="@+id/saverDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="17sp"
            android:shadowColor="#99000000"
            android:shadowRadius="8"
            android:shadowDx="0"
            android:shadowDy="1" />
    </LinearLayout>
</FrameLayout>
